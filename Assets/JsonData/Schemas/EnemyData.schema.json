{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://lff.game/schema/EnemyData.schema.json",
    "title": "EnemyData",
    "description": "敵キャラクターデータ定義",
    "type": "object",

    "properties": {

        "$schema": true,

        "id": {
            "type": "integer",
            "minimum": 1,
            "description": "敵ID"
        },

        "name": {
            "type": "string",
            "minLength": 1,
            "description": "敵の表示名。例: スライム"
        },

        "type": {
            "type": "string",
            "description": "敵の種類（EnemyType）",
            "enum": [
                "test"
            ]
        },

        "hp": {
            "type": "integer",
            "minimum": 1,
            "description": "最大HP"
        },

        "attack": {
            "type": "integer",
            "minimum": 0,
            "description": "攻撃力"
        },

        "shape": {
            "type": "array",
            "description": "敵形状を構成する相対座標の配列 [[x,y],...]",
            "items": {
                "type": "array",
                "items": [
                    { "type": "integer" },
                    { "type": "integer" }
                ],
                "minItems": 2,
                "maxItems": 2
            },
            "minItems": 1
        }
    },

    "required": [
        "id",
        "name",
        "type",
        "hp",
        "attack",
        "shape"
    ],

    "additionalProperties": false
}